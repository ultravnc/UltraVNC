IDD_TVMANAGER DIALOGEX 0, 0, 414, 265
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "UltraVNC Token Manager"
FONT 11, "MS Shell Dlg", 400, 0, 0x0
BEGIN
    LTEXT           "&Users:",IDC_STATIC,7,7,30,8
    LISTBOX         IDC_TV_USER_LIST,7,18,160,170,LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Username:",IDC_STATIC,7,195,40,8
    EDITTEXT        IDC_TV_USERNAME,50,193,117,12,ES_AUTOHSCROLL
    PUSHBUTTON      "&Add",IDC_TV_ADD,7,210,50,14
    PUSHBUTTON      "&Remove",IDC_TV_REMOVE,62,210,50,14
    PUSHBUTTON      "Reset &TOTP",IDC_TV_RESET,117,210,50,14
    PUSHBUTTON      "&Show QR",IDC_TV_SHOWQR,172,210,50,14
    PUSHBUTTON      "Clear T&OTP",IDC_TV_DELTOTP,227,210,55,14
    CONTROL         "",IDC_TV_QR_IMAGE,"Static",SS_BITMAP | SS_CENTERIMAGE | WS_BORDER | WS_TABSTOP,180,18,230,170
    LTEXT           "Provisioning URI:",IDC_STATIC,180,195,60,8
