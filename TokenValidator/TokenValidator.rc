    LTEXT           "&Password:",IDC_STATIC,7,230,40,8
    EDITTEXT        IDC_TV_PASSWORD,50,228,117,12,ES_PASSWORD | ES_AUTOHSCROLL
    PUSHBUTTON      "Set pass&word",IDC_TV_SETPASS,172,226,55,14
    PUSHBUTTON      "T&est password",IDC_TV_TESTPASS,232,226,55,14
    PUSHBUTTON      "Clear pass&word",IDC_TV_DELPASS,292,226,55,14
    LTEXT           "",IDC_TV_FACTORS,7,246,290,10
    DEFPUSHBUTTON   "OK",IDOK,306,246,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,360,246,50,14
END

