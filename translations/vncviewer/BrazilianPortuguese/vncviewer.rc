    CONTROL         "AUTO    (Selecionar automaticamente as melhores configurações)",IDC_DYNAMIC,"Button",BS_AUTORADIOBUTTON,9,14,257,10
    CONTROL         "VÍDEO   (> 2 Mbit/s)",IDC_ULTRA_LAN_RB,"Button",BS_AUTORADIOBUTTON,9,28,257,10
    CONTROL         "LAN     (> 1 Mbit/s) - Máx. de cores",IDC_LAN_RB,"Button",BS_AUTORADIOBUTTON,9,42,257,10
    CONTROL         "MÉDIO   (128 - 256 Kbit/s) - 256 cores",IDC_MEDIUM_RB,
                    "Button",BS_AUTORADIOBUTTON,9,56,257,10
    CONTROL         "MODEM   (19 - 128 Kbit/s) - 64 cores",IDC_MODEM_RB,
                    "Button",BS_AUTORADIOBUTTON,9,70,257,10
    CONTROL         "LENTO   (< 19 Kbit/s) - 8 cores",IDC_SLOW_RB,"Button",BS_AUTORADIOBUTTON,9,84,257,10
    CONTROL         "MANUAL  (Usar botão de opções)",IDC_MANUAL,"Button",BS_AUTORADIOBUTTON,9,98,257,10
END

IDD_LISTEN DIALOGEX 0, 0, 270, 145
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
FONT 11, "MS Shell Dlg", 400, 0, 0x0
BEGIN
    EDITTEXT        IDC_LISTENPORT,23,24,40,14,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "Iniciar escuta",IDC_STARTLISTEN,76,24,61,14
    LTEXT           "Modo de escuta",IDC_STATIC,4,10,133,8
    LTEXT           "Porta",IDC_STATIC,4,27,17,8
END

IDD_CONFIG DIALOGEX 0, 0, 270, 145
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
FONT 11, "MS Shell Dlg", 400, 0, 0x0
BEGIN
    CONTROL         "Usar somente options.vnc",IDC_CHECKCONFIG,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,4,7,129,10
    EDITTEXT        IDC_DEFAULTCONFIG,11,34,245,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    EDITTEXT        IDC_CUSTOMCONFIG,12,64,244,12,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    GROUPBOX        "Arquivo de configuração padrão",IDC_STATIC,4,21,262,27
    GROUPBOX        "Arquivo de configuração personalizado",IDC_STATIC,4,53,262,27
END


