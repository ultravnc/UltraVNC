IDR_TRAYMENU MENU
BEGIN
    POPUP "t"
    BEGIN
        MENUITEM "Nova conexão",              ID_NEWCONN
        MENUITEM "Opções de conexão",          IDC_OPTIONBUTTON
        MENUITEM SEPARATOR
        MENUITEM "&Sobre o UltraVNC Viewer...",   IDD_APP_ABOUT
        MENUITEM SEPARATOR
        MENUITEM "Alternar modo de escuta (Ligado/Desligado)", ID_LISTEN_MODE
        MENUITEM "Fechar ícone da bandeja",             ID_CLOSEAPP
    END
END

IDR_tbMENU MENU
BEGIN
    POPUP "Menu do botão direito para legenda de tela cheia"
    BEGIN
        MENUITEM "Restaurar",                     IDC_NULL
        MENUITEM "Minimizar",                    IDC_NULL
        MENUITEM SEPARATOR
        MENUITEM "Fechar",                       IDC_NULL
    END
END


