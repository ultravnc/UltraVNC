    CONTROL         "Klawiatura japońska",IDC_JAPKEYBOARD,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,6,91,260,10
    LTEXT           "Ograniczenie zdarzeń myszy (ms)",IDC_STATIC,6,106,105,11
    EDITTEXT        IDC_MOUSE_THROTTLE,115,104,42,12,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "Gii",IDC_GII,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,6,117,105,10
END

IDD_QUICKOPTIONS DIALOGEX 0, 0, 270, 145
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
FONT 11, "MS Shell Dlg", 400, 0, 0x0
BEGIN
    CONTROL         "AUTO (Automatyczny wybór)",IDC_DYNAMIC,"Button",BS_AUTORADIOBUTTON,9,14,257,10
    CONTROL         "WIDEO (> 2Mbit/s)",IDC_ULTRA_LAN_RB,"Button",BS_AUTORADIOBUTTON,9,28,257,10
    CONTROL         "LAN (> 1Mbit/s) - Maksymalna paleta kolorów",IDC_LAN_RB,"Button",BS_AUTORADIOBUTTON,9,42,257,10
    CONTROL         "ŚREDNIE (128-256Kbit/s) - 256 kolorów",IDC_MEDIUM_RB,
                    "Button",BS_AUTORADIOBUTTON,9,56,257,10
    CONTROL         "MODEM (19-128Kbit/s) - 64 kolory",IDC_MODEM_RB,"Button",BS_AUTORADIOBUTTON,9,70,257,10
    CONTROL         "WOLNE (< 19Kbit/s) - 8 kolorów",IDC_SLOW_RB,"Button",BS_AUTORADIOBUTTON,9,84,257,10
    CONTROL         "RĘCZNE (Użyj własnych opcji)",IDC_MANUAL,"Button",BS_AUTORADIOBUTTON,9,98,257,10
END

IDD_LISTEN DIALOGEX 0, 0, 270, 145
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
