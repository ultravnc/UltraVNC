IDR_TRAYMENU MENU
BEGIN
    POPUP "t"
    BEGIN
        MENUITEM "Nowe połączenie",             ID_NEWCONN
        MENUITEM "Opcje połączenia",            IDC_OPTIONBUTTON
        MENUITEM SEPARATOR
        MENUITEM "&O programie UltraVNC Viewer...", IDD_APP_ABOUT
        MENUITEM SEPARATOR
        MENUITEM "Przełącz tryb nasłuchiwania (Wł/Wył)", ID_LISTEN_MODE
        MENUITEM "Zamknij ikonę powiadomień",  ID_CLOSEAPP
    END
END

IDR_tbMENU MENU
BEGIN
