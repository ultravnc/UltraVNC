    DEFPUSHBUTTON   "Uruchom nasłuch",IDC_STARTLISTEN,76,24,61,14
    LTEXT           "Tryb nasłuchu",IDC_STATIC,4,10,133,8
    LTEXT           "Port",IDC_STATIC,4,27,17,8
END

IDD_CONFIG DIALOGEX 0, 0, 270, 145
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
FONT 11, "MS Shell Dlg", 400, 0, 0x0
BEGIN
