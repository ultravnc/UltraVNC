/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_TRAYMENU MENU
BEGIN
    POPUP "tray"
    BEGIN
        MENUITEM "&Configurações",                   ID_ADMIN_PROPERTIES
        MENUITEM SEPARATOR
        MENUITEM "&Sobre o UltraVNC Server...",   ID_ABOUT
        POPUP "Visite nossos links"
        BEGIN
            MENUITEM "Página inicial",                    ID_VISITUSONLINE_HOMEPAGE
            MENUITEM "Fórum",                       ID_VISITUSONLINE_FORUM
            MENUITEM "GitHub",                      ID_VISITUSONLINE_GITHUB
            MENUITEM "Mastodon",                    ID_VISITUSONLINE_MASTODON
            MENUITEM "Bluesky",                     ID_VISITUSONLINE_BLUESKY
            MENUITEM "Facebook",                    ID_VISITUSONLINE_FACEBOOK
            MENUITEM "X/Twitter",                   ID_VISITUSONLINE_XTWITTER
            MENUITEM "Reddit",                      ID_VISITUSONLINE_REDDIT
            MENUITEM "OpenHub",                     ID_VISITUSONLINE_OPENHUB
        END
        MENUITEM SEPARATOR
        MENUITEM "Adicionar &novo cliente",             ID_OUTGOING_CONN
        MENUITEM "&Desconectar todos os clientes",           ID_KILLCLIENTS
        MENUITEM SEPARATOR
        MENUITEM "&Listar todos os clientes",           ID_LISTCLIENTS
        MENUITEM SEPARATOR
        MENUITEM "Instalar serviço",             ID_RUNASSERVICE
        MENUITEM "Desinstalar serviço",           ID_UNINSTALL_SERVICE
        MENUITEM "Parar serviço",                ID_CLOSE_SERVICE
        MENUITEM "Iniciar serviço (deve ser instalado primeiro)", ID_START_SERVICE
        MENUITEM "Reiniciar em modo de segurança",         ID_REBOOTSAFEMODE
        MENUITEM "Forçar reinicialização (não segura)",       ID_REBOOT_FORCE
        MENUITEM SEPARATOR
        MENUITEM "&Fechar conexões VNC",      ID_CLOSE
    END
END

IDR_TRAYMENU1 MENU
BEGIN
    POPUP "tray"
    BEGIN
        MENUITEM "&Sobre o UltraVNC Server...",   ID_ABOUT
        MENUITEM SEPARATOR
        MENUITEM "&Fechar conexões VNC",      ID_CLOSE
    END
END


